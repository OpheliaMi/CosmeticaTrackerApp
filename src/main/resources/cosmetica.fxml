                                        <MenuItem mnemonicParsing="false" onAction="#setPurpleTheme" text="Королевский пурпур 👑" />
                                    </items>
                                </Menu>

                                <!-- 🌟 НОВОЕ МЕНЮ НАСТРОЙКИ ШРИФТОВ -->
                                <Menu mnemonicParsing="false" text="Шрифты">
