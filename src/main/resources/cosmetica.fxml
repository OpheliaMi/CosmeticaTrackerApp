                <Tab text="Румяна"><content><TableView fx:id="tableBlush"><columns><TableColumn prefWidth="80.0" text="фото" /><TableColumn prefWidth="150.0" text="название" /><TableColumn prefWidth="120.0" text="годен до:" /><TableColumn prefWidth="250.0" text="комент" /><TableColumn prefWidth="120.0" text="действия" /></columns><columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy></TableView></content></Tab>
